#!/bin/sh
# wlan0（USB Wi-Fi dongle、例: GW-USEco300/RTL8192CU）を WPA2-PSK の
# アクセスポイントへ接続する。SSID/PSK は引数で渡し、実行時だけ使う
# /var/run 配下の設定へ書く。イメージや overlay には埋め込まない。
#
# wlan0 は usb0 が host role になり（brainwrt-usb-mode host 参照）、dongle が
# hub の背後で enumerate された後にだけ存在する。
set -e

usage() {
	echo "usage: $0 <ssid> <psk>" >&2
	exit 1
}

escape_wpa_value() {
	value=$1
	# wpa_supplicant の quoted value では制御文字を許可しない。バックスラッシュ
	# と二重引用符だけをエスケープし、SSID/PSK の通常の UTF-8 や空白は残す。
	if printf '%s' "$value" | grep -q '[[:cntrl:]]'; then
		echo "SSID/PSK に制御文字は使用できません" >&2
		exit 1
	fi
	printf '%s' "$value" | sed 's/[\\"]/\\&/g'
}

[ $# -eq 2 ] || usage
SSID="$1"
PSK="$2"
IFACE=wlan0
SSID_ESC=$(escape_wpa_value "$SSID")
PSK_ESC=$(escape_wpa_value "$PSK")

[ -d "/sys/class/net/$IFACE" ] || { echo "no $IFACE (dongle not enumerated? run brainwrt-usb-mode host first)" >&2; exit 1; }

ip link set "$IFACE" up

CONF="/var/run/wpa_supplicant-$IFACE.conf"
cat > "$CONF" <<EOF
ctrl_interface=/var/run/wpa_supplicant
network={
	ssid="$SSID_ESC"
	psk="$PSK_ESC"
}
EOF
chmod 600 "$CONF"

killall wpa_supplicant 2>/dev/null || true
sleep 1
wpa_supplicant -B -i "$IFACE" -c "$CONF"

# DHCP の前に association を待つ。brainwrt-usb-mode の ethX 出現待ちと同じ
# 考え方で、リンクが up していない状態で udhcpc を起動しない。
i=0
while [ $i -lt 15 ]; do
	iw dev "$IFACE" link 2>/dev/null | grep -q "^Connected to" && break
	sleep 1
	i=$((i + 1))
done

udhcpc -i "$IFACE" -n -q -s /usr/share/udhcpc/brainwrt-host.script || echo "udhcpc on $IFACE failed" >&2
