#!/bin/sh
# brainwrt-ct: ujail + overlayfs + cgroup v2 による軽量コンテナランチャ。
# バンドルは $APPS/<name>/ に manifest.conf, root/(overlay upper), work/, merged/ を持つ。
set -eu

APPS="${BRAINWRT_CT_APPS:-/data/apps}"
CGROOT="${BRAINWRT_CT_CGROOT:-/sys/fs/cgroup}"
CGBASE="$CGROOT/brainwrt-ct"
RUN="${BRAINWRT_CT_RUN:-/var/run/brainwrt-ct}"
DRY="${BRAINWRT_CT_DRYRUN:-0}"
KDRESET="${BRAINWRT_CT_KDRESET:-brainwrt-kdreset}"
VTRESET="${BRAINWRT_CT_VTRESET:-brainwrt-vtreset}"
REAP_POLL="${BRAINWRT_CT_REAP_POLL:-1}"

die() { echo "brainwrt-ct: $*" >&2; exit 1; }
# dry-run 対応の実行ヘルパ
run() { if [ "$DRY" = 1 ]; then echo "+ $*"; else "$@"; fi; }
# cgroup ファイル書き込み(dry-run 時はエコー)
cgset() { # cgset <file> <value>
  if [ "$DRY" = 1 ]; then echo "$(basename "$1") <- $2";
  else printf '%s\n' "$2" > "$1" 2>/dev/null || echo "brainwrt-ct: warn: cannot set $1 (controller not delegated?)" >&2; fi
}

to_bytes() { # 32M/512K/1G/整数 -> バイト
  v=$1; n=${v%[KMGkmg]}; u=${v#$n}
  case "$u" in
    K|k) echo $((n*1024));; M|m) echo $((n*1024*1024));;
    G|g) echo $((n*1024*1024*1024));; "") echo "$n";;
    *) die "bad size: $v";;
  esac
}
cpu_quota() { # "50%" -> "50000 100000"(period=100000us)
  p=${1%\%}; echo "$((p*1000)) 100000"
}
cgv() { cat "$1" 2>/dev/null; }   # cgroup ファイル読み(欠損時は空文字)
human() { # bytes -> 0.44M など人間可読に; ""/max は "-"
  case "${1:-}" in ''|max) echo '-'; return;; esac
  awk -v b="$1" 'BEGIN{
    if(b<1024)            printf "%dB",   b;
    else if(b<1048576)    printf "%.1fK", b/1024;
    else if(b<1073741824) printf "%.1fM", b/1048576;
    else                  printf "%.2fG", b/1073741824;
  }'
}
cpu_usage_usec() { awk '/^usage_usec/{print $2}' "$1/cpu.stat" 2>/dev/null; }
cpu_stat_field() { awk -v k="$2" '$1==k{print $2}' "$1/cpu.stat" 2>/dev/null; }
mf_val() { # mf_val <name> <key> : manifest から 1 値取得(key="v" / key=v 両対応)
  sed -n "s/^$2=\"\{0,1\}\([^\"]*\)\"\{0,1\}.*/\1/p" "$APPS/$1/manifest.conf" 2>/dev/null | head -1
}
# cgroup.procs は sysfs 上、中身があっても stat サイズ 0 を返すため [ -s ] は使えない。
# 実際に 1 行(PID)読めるかで稼働判定する。
has_procs() { [ -e "$1/cgroup.procs" ] && read -r _ < "$1/cgroup.procs" 2>/dev/null; }
ct_up() { has_procs "$CGBASE/$1"; }
ct_mounted() { grep -q " $APPS/$1/merged overlay " /proc/mounts 2>/dev/null; }

load_manifest() {
  name=$1; d="$APPS/$name"
  [ -f "$d/manifest.conf" ] || die "no manifest: $d/manifest.conf"
  exec=""; mem_max=""; cpu_max=""; devices=""; seccomp="default"; hostname="$name"; autostart="0"
  . "$d/manifest.conf"
  [ -n "$exec" ] || die "manifest: exec is empty"
}

cmd_up() {
  name=$1; load_manifest "$name"; d="$APPS/$name"
  merged="$d/merged"; upper="$d/root"; work="$d/work"
  mkdir -p "$upper" "$work" "$merged"
  # overlay マウント
  run mount -t overlay overlay -o "lowerdir=/,upperdir=$upper,workdir=$work" "$merged"
  # cgroup 作成＋コントローラ有効化＋上限
  cg="$CGBASE/$name"
  run mkdir -p "$cg"
  # cgroup v2 はコントローラをルートから順に delegate する必要があるため、
  # ルート階層でも best-effort で有効化しておく(失敗しても down-grade して続行)。
  [ "$DRY" = 1 ] || echo "+memory +cpu" > "$CGROOT/cgroup.subtree_control" 2>/dev/null || true
  [ "$DRY" = 1 ] || echo "+memory +cpu" > "$CGBASE/cgroup.subtree_control" 2>/dev/null || true
  [ -n "$mem_max" ] && cgset "$cg/memory.max" "$(to_bytes "$mem_max")"
  [ -n "$cpu_max" ] && cgset "$cg/cpu.max" "$(cpu_quota "$cpu_max")"
  # --- ujail コマンド組み立て(HWで要検証のフラグはこのブロックだけ) ---
  set -- ujail -R "$merged" -p -h "$hostname"
  [ "$seccomp" = none ] || [ "$seccomp" = default ] || set -- "$@" -S "$seccomp"
  for dev in $devices; do set -- "$@" -w "$dev"; done
  set -- "$@" -- "$exec"
  # --- ここまで ---
  if [ "$DRY" = 1 ]; then
    echo "+ $*"
    return 0
  fi
  mkdir -p "$RUN"
  setsid sh -c 'echo $$ > "$1/cgroup.procs"; shift; exec "$@"' _ "$cg" "$@" \
    >"$d/log" 2>&1 &
  echo $! > "$RUN/$name.pid"
  echo "brainwrt-ct: up $name (pid $(cat "$RUN/$name.pid"))"
  # Reaper: if the bundle's own process exits on its own (e.g. quitting
  # neovim via :q, or a game's own in-game quit) rather than via
  # `ct down`, nobody would otherwise run the teardown (overlay
  # unmount, cgroup removal, KD_TEXT/VT reset) -- the console/VT would
  # stay in whatever state the bundle left it, exactly like the
  # neovim bundle's own console-takeover found on real hardware.
  reap_on_exit "$name" "$cg" &
}

# cmd_up の一部として起動する常駐ウォッチャ。cgroup.procs をポーリングし
# (プロセス登録待ちを固定回数だけ待ってから空になるのを待つ -- `echo $$ >
# cgroup.procs` がまだ実行される前の「もう down している」誤読を避ける)、
# 実際に登録→消滅を観測できた場合にのみ cmd_down を自動で呼ぶ。`ct down`
# が競合しても安全(cmd_down 自体は umount/rmdir 等すべて「既に無い」を
# 許容する冪等な作り)。ポーリング間隔は BRAINWRT_CT_REAP_POLL で上書き可能
# (テストで実秒待ちを避けるため)。
reap_on_exit() { # reap_on_exit <name> <cg>
  rname=$1; rcg=$2
  tries=0
  while ! has_procs "$rcg" && [ "$tries" -lt 50 ]; do
    sleep "$REAP_POLL"; tries=$((tries + 1))
  done
  # 登録そのものが一度も観測できなかった場合(dry-run/テスト環境で cgroup
  # が実体を持たない、または起動が本当に壊れている場合)は何もしない --
  # 実際の終了に対する反応ではなく、無条件の後始末になってしまうため。
  if has_procs "$rcg"; then
    while has_procs "$rcg"; do sleep "$REAP_POLL"; done
    cmd_down "$rname" >/dev/null 2>&1
  fi
}

cmd_down() {
  name=$1; d="$APPS/$name"; cg="$CGBASE/$name"; merged="$d/merged"
  if [ -f "$cg/cgroup.kill" ]; then run sh -c "echo 1 > '$cg/cgroup.kill'"; else
    [ -f "$cg/cgroup.procs" ] && for p in $(cat "$cg/cgroup.procs" 2>/dev/null); do run kill "$p" 2>/dev/null || true; done
  fi
  run umount "$merged" 2>/dev/null || true
  run rmdir "$cg" 2>/dev/null || true
  run rm -f "$RUN/$name.pid"
  # cgroup.kill (used above when present) sends an uncatchable SIGKILL to
  # every process in the cgroup, so a bundle that put the console into
  # KD_GRAPHICS mode (a bundle that draws straight to the framebuffer)
  # never gets a
  # chance to run its own cleanup -- the tty is left stuck in graphics
  # mode. Unconditionally reset it here; harmless no-op for bundles that
  # never touched console mode, and best-effort (must never fail `down`).
  run "$KDRESET" 2>/dev/null || true
  # Same reasoning for a bundle that switched the active VT away from
  # tty1 (a bundle with a full-screen TUI, to avoid racing the login
  # shell for keyboard input -- see profiles/imx28/tools/vtreset/vtreset.c).
  # Unconditionally switch back; harmless no-op for bundles that never
  # touched VT switching. Explicit "1" (not vtreset's own no-arg
  # toggle behavior, meant for interactive use) since this must
  # deterministically land on tty1 regardless of whatever VT happens
  # to be active.
  run "$VTRESET" 1 2>/dev/null || true
  echo "brainwrt-ct: down $name"
}

# 登録済みバンドル(=$APPS/*/manifest.conf を持つもの)を全て state 付きで一覧
cmd_list() {
  [ -d "$APPS" ] || { echo "(no apps dir: $APPS)"; return 0; }
  printf '%-12s %-5s %-4s %-4s %-15s %-8s %-7s %s\n' \
    NAME STATE AUTO PIDS MEM/LIM PEAK 'CPU(s)' THROTL
  found=0
  for d in "$APPS"/*/; do
    [ -f "$d/manifest.conf" ] || continue
    found=1
    n=$(basename "$d"); cg="$CGBASE/$n"
    [ "$(mf_val "$n" autostart)" = 1 ] && auto=on || auto=off
    if ct_up "$n"; then
      st=up
      pids=$(grep -c '' "$cg/cgroup.procs" 2>/dev/null || echo 0)
      cur=$(cgv "$cg/memory.current"); max=$(cgv "$cg/memory.max"); peak=$(cgv "$cg/memory.peak")
      u=$(cpu_usage_usec "$cg"); : "${u:=0}"
      cpus=$(awk -v u="$u" 'BEGIN{printf "%.1f", u/1000000}')
      np=$(cpu_stat_field "$cg" nr_periods); : "${np:=0}"
      nt=$(cpu_stat_field "$cg" nr_throttled); : "${nt:=0}"
      memcol="$(human "$cur")/$(human "$max")"; peakcol=$(human "$peak"); thr="$nt/$np"
    else
      st=down; pids=-; memcol=-; peakcol=-; cpus=-; thr=-
    fi
    printf '%-12s %-5s %-4s %-4s %-15s %-8s %-7s %s\n' \
      "$n" "$st" "$auto" "$pids" "$memcol" "$peakcol" "$cpus" "$thr"
  done
  [ "$found" = 1 ] || echo "(none registered)"
}

# 稼働中コンテナの CPU%/MEM% を interval 秒サンプルして 1 回表示(既定 1 秒)
cmd_top() {
  interval="${1:-1}"
  [ -d "$CGBASE" ] || { echo "(no running containers)"; return 0; }
  snap="${TMPDIR:-/tmp}/brainwrt-ct-top.$$"; : > "$snap"
  running=0
  for cg in "$CGBASE"/*/; do
    [ -d "$cg" ] || continue
    has_procs "$cg" || continue
    running=1
    u=$(cpu_usage_usec "$cg"); : "${u:=0}"
    printf '%s\t%s\n' "$(basename "$cg")" "$u" >> "$snap"
  done
  [ "$running" = 1 ] || { echo "(no running containers)"; rm -f "$snap"; return 0; }
  sleep "$interval"
  printf '%-12s %-4s %-15s %-6s %s\n' NAME PIDS MEM/LIM MEM% CPU%
  while IFS='	' read -r n u0; do
    cg="$CGBASE/$n"
    pids=$(grep -c '' "$cg/cgroup.procs" 2>/dev/null || echo 0)
    cur=$(cgv "$cg/memory.current"); max=$(cgv "$cg/memory.max")
    u1=$(cpu_usage_usec "$cg"); : "${u1:=0}"
    cpu=$(awk -v a="$u0" -v b="$u1" -v i="$interval" 'BEGIN{d=b-a; if(d<0)d=0; printf "%.1f", d/(i*1000000)*100}')
    memp=$(awk -v c="$cur" -v m="$max" 'BEGIN{ if(m ~ /^[0-9]+$/ && m+0>0) printf "%.1f", c/m*100; else printf "-"}')
    printf '%-12s %-4s %-15s %-6s %s\n' "$n" "$pids" "$(human "$cur")/$(human "$max")" "${memp}%" "${cpu}%"
  done < "$snap"
  rm -f "$snap"
}

cmd_logs() { name=$1; tail -n "${2:-20}" "$APPS/$name/log"; }

# autostart フラグを manifest 内で切替(sed -i を避け temp+mv で BSD/GNU 両対応)
set_autostart() { # set_autostart <name> <0|1>
  n=$1; val=$2; f="$APPS/$n/manifest.conf"
  [ -f "$f" ] || die "not registered: $n"
  tmp="$f.tmp.$$"
  if grep -q '^autostart=' "$f"; then
    sed 's/^autostart=.*/autostart="'"$val"'"/' "$f" > "$tmp"
  else
    { cat "$f"; echo "autostart=\"$val\""; } > "$tmp"
  fi
  mv "$tmp" "$f"
}
cmd_enable()  { set_autostart "$1" 1; echo "brainwrt-ct: enabled $1 (autostart on)"; }
cmd_disable() { set_autostart "$1" 0; echo "brainwrt-ct: disabled $1 (autostart off)"; }

# バンドルを $APPS/<name>/ に登録(src はディレクトリまたは tar)
cmd_install() {
  name=${1:?"usage: install <name> <dir|tar>"}; src=${2:?"usage: install <name> <dir|tar>"}
  dst="$APPS/$name"
  [ -e "$dst" ] && die "already registered: $name (remove it first)"
  run mkdir -p "$dst"
  if [ -d "$src" ]; then run sh -c "cp -a \"$src/.\" \"$dst/\""
  elif [ -f "$src" ]; then
    # 展開前にメンバー名を検査し、絶対パス/`..`要素を含むものを拒否する
    # (BusyBox tar 自体は無害化するが、tar実装依存にしない防御多重化)。
    if tar tf "$src" 2>/dev/null | grep -qE '(^/|(^|/)\.\.(/|$))'; then
      rm -rf "$dst"
      die "unsafe tar member path (absolute or '..') in: $src"
    fi
    run tar xf "$src" -C "$dst"
  else die "no such source: $src"; fi
  [ "$DRY" = 1 ] || [ -f "$dst/manifest.conf" ] || { rm -rf "$dst"; die "invalid bundle (no manifest.conf): $src"; }
  echo "brainwrt-ct: installed $name"
}

# バンドルを登録解除($APPS/<name>/ 削除)。稼働中は --force で down してから
cmd_remove() {
  name=${1:?"usage: remove <name> [--force]"}; force=${2:-}
  d="$APPS/$name"; [ -d "$d" ] || die "not registered: $name"
  if ct_up "$name" || ct_mounted "$name"; then
    [ "$force" = --force ] || die "$name is up (or overlay still mounted); run 'down $name' first or pass --force"
    cmd_down "$name"
  fi
  # procs が死んでいても overlay が残っていれば剥がしてから削除(クラッシュ後の後始末)
  ct_mounted "$name" && run umount "$d/merged" 2>/dev/null || true
  run rm -rf "$d"
  echo "brainwrt-ct: removed $name"
}

# レジストリからバンドルを取得し登録する。既に同名バンドルが登録済みなら
# down してから入れ替える(pull 自体は入れ替え後に自動 up しない)。
cmd_pull() {
  # 注意: このスクリプトに local 宣言は無く、name/dst 等は全関数共有のグロー
  # バル変数。cmd_install/cmd_down を呼ぶと内部で name が書き換わってしまう
  # ため、対象名は pull_name/staging という専用変数に保持し、以後 $name は
  # 参照しない。
  pull_name=${1:?"usage: pull <name> [version]"}; version=${2:-latest}
  url="${BRAINWRT_CT_REGISTRY_URL:?"BRAINWRT_CT_REGISTRY_URL not set"}/bundles/$pull_name/$version"
  tmp="${TMPDIR:-/tmp}/brainwrt-ct-pull-$pull_name.$$"
  staging=""
  # staging はまだ計算前(=空文字)のことがあり、cmd_install 内の tar 展開失敗
  # 等で trap がその状態で発火しても set -u で落ちないよう先に初期化しておく。
  # 末尾の true は cleanup 自体の失敗が本来の exit status を隠さないため。
  #
  # staging_cleanup は「staging を計算した直後 〜 cmd_install が成功して
  # 戻るまで」の間だけ 1 にする専用フラグ。cmd_install 成功後は staging は
  # 検証済みの正規バンドルであり、それ以降(旧バンドルの down/rm や最終 mv)
  # がどこで失敗しても trap は staging を消してはいけない
  # (壊れた入れ替えを手動復旧できるよう残す)。0 で初期化するのは、trap 発火時
  # に staging_cleanup が未定義だと set -u で落ちるため。
  staging_cleanup=0
  trap 'rm -f "$tmp"; [ "$staging_cleanup" = 1 ] && run rm -rf "$APPS/$staging" 2>/dev/null; true' EXIT
  wget -O "$tmp" "$url" || die "pull failed: $url"
  [ -s "$tmp" ] || die "pull failed: empty response from $url"
  # まず staging 名で検証込みインストール(manifest.conf 欠損等は cmd_install が
  # die してくれる)。ここで失敗しても既存の $APPS/$pull_name は一切触れていない。
  staging="$pull_name.pull.$$"
  staging_cleanup=1
  cmd_install "$staging" "$tmp"
  # cmd_install はここまで来た時点で成功が確定している(失敗時は内部で die
  # して EXIT trap 経由でこの関数を抜ける)。staging は検証済み正規バンドル
  # になったので、以降は trap の cleanup 対象から外す。
  staging_cleanup=0
  if [ -d "$APPS/$pull_name" ]; then
    cmd_down "$pull_name" 2>/dev/null || true
    run rm -rf "$APPS/$pull_name"
  fi
  run mv "$APPS/$staging" "$APPS/$pull_name"
}

case "${1:-}" in
  up)      shift; cmd_up "$@";;
  down)    shift; cmd_down "$@";;
  list)    cmd_list;;
  top)     shift; cmd_top "$@";;
  logs)    shift; cmd_logs "$@";;
  enable)  shift; cmd_enable "$@";;
  disable) shift; cmd_disable "$@";;
  install) shift; cmd_install "$@";;
  remove)  shift; cmd_remove "$@";;
  pull)    shift; cmd_pull "$@";;
  *) die "usage: brainwrt-ct {up|down|list|top|logs|enable|disable|install|remove|pull} <name> [args]";;
esac
