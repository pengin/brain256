#!/bin/sh
# 手動 USB host-mode ネットワーク経路（brainwrt-usb-mode host）用の udhcpc スクリプト。
# ethX/wlan0 に紐づく netifd proto はなく、このビルドでは dnsmasq も削除している。
# そのため標準の /usr/share/udhcpc/default.script（インターフェースのアドレス／経路
# だけを設定）は、DHCP で受け取った DNS サーバーを /etc/resolv.conf へ書かない。
# 標準スクリプトを呼んだ上で DNS を追加する。
[ -z "$1" ] && echo "Error: should be run by udhcpc" && exit 1

/usr/share/udhcpc/default.script "$1"

case "$1" in
bound|renew)
	{
		for ns in $dns; do
			echo "nameserver $ns"
		done
	} > /etc/resolv.conf
	;;
deconfig)
	: > /etc/resolv.conf
	;;
esac

exit 0
