config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

# USB gadget ether（/etc/init.d/brainwrt-gadget 参照）。PC 側を
# 192.168.28.1/24 に手動設定し、その後 ssh root@192.168.28.2 で接続する。
config interface 'usb'
	option device 'usb0'
	option proto 'static'
	option ipaddr '192.168.28.2'
	option netmask '255.255.255.0'
