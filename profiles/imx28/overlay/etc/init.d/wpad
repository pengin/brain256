#!/bin/sh /etc/rc.common
# Stub override for hostapd-common's stock /etc/init.d/wpad (pulled in
# automatically as a wpa-supplicant-mini dependency, enabled by default).
# That service starts a global wpa_supplicant instance
# (-g /var/run/wpa_supplicant/global) meant to be driven by netifd via
# /etc/config/wireless. This project has no netifd wireless config and
# manages wlan0 manually (see /usr/sbin/brainwrt-wifi-connect); running
# both at once puts two wpa_supplicant processes on the same nl80211
# interface, which was observed to cause a periodic deauth/reauth loop
# and the interface never getting a stable DHCP lease. Left as a stub
# (rather than removed) so `/etc/init.d/wpad enable` from a future
# package update doesn't silently resurrect the conflict.
START=19
STOP=21

start_service() {
	:
}
