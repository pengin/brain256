#!/bin/sh /etc/rc.common
# hostapd-common の標準 /etc/init.d/wpad に対する上書きスタブ
#（wpa-supplicant-mini の依存関係として自動的に入り、既定で有効になる）。
# このサービスは netifd が /etc/config/wireless 経由で制御するグローバルな
# wpa_supplicant（-g /var/run/wpa_supplicant/global）を起動する。しかしこのプロジェクト
# には netifd の無線設定がなく、wlan0 は手動管理する
#（/usr/sbin/brainwrt-wifi-connect 参照）。両方を動かすと同じ nl80211
# インターフェース上で wpa_supplicant が 2 つ動き、周期的な deauth/reauth ループと
# DHCP リースの不安定化が起きることを確認した。スタブとして残すのは、
# 将来のパッケージ更新で `/etc/init.d/wpad enable` が競合を黙って復活させないため。
START=19
STOP=21

start_service() {
	:
}
