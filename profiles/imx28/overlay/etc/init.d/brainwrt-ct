#!/bin/sh /etc/rc.common
# 起動時に autostart="1" のバンドルを up する。
START=95
STOP=10

APPS="${APPS:-/data/apps}"
BRAINWRT_CT="${BRAINWRT_CT:-/usr/sbin/brainwrt-ct}"

ct_autostart_all() {
  for d in "$APPS"/*/; do
    [ -f "$d/manifest.conf" ] || continue
    # 配置は外部から取得したバンドルにも含まれるため source しない。
    # autostart の 1 値だけを読み取り、manifest 内のシェル文を実行しない。
    autostart=$(sed -n 's/^autostart="\{0,1\}\([^"]*\)"\{0,1\}.*/\1/p' \
      "$d/manifest.conf" 2>/dev/null | head -1)
    [ "$autostart" = "1" ] || continue
    "$BRAINWRT_CT" up "$(basename "$d")"
  done
}

start() { ct_autostart_all; }

stop() {
  for d in "$APPS"/*/; do
    [ -d "$d" ] || continue
    "$BRAINWRT_CT" down "$(basename "$d")" 2>/dev/null || true
  done
}
